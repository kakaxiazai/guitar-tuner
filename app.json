{
  "expo": {
    "name": "吉他调音器",
    "slug": "guitar-tuner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "此应用需要访问麦克风以进行吉他调音",
        "UIBackgroundModes": []
      },
      "bundleIdentifier": "com.kakaxiazai.guitartuner",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "package": "com.kakaxiazai.guitartuner",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "13f071fb-7286-4719-a225-ca51afde172b"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "此应用需要访问麦克风以检测吉他音高"
        }
      ],
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosConfig": {
            "microphoneUsageDescription": "此应用需要访问麦克风以检测吉他音高"
          }
        }
      ]
    ],
    "owner": "kakaxiazai"
  }
}
